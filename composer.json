{
    "name": "stevelacey/laravel-browsable-api",
    "description": "Browsable API for Laravel, based on Django REST Framework's Browsable API",
    "keywords": ["laravel", "browsable", "api", "drf", "rest", "framework"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "illuminate/support": ">=12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "suggest": {
        "barryvdh/laravel-debugbar": "Integrates PHP Debug Bar",
        "beyondcode/laravel-query-detector": "Notifies you when you should add eager loading (N+1 queries)"
    },
    "autoload": {
        "psr-4": {
            "SteveLacey\\LaravelBrowsableApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SteveLacey\\LaravelBrowsableApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint $([ \"$CI\" ] && echo --test)",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SteveLacey\\LaravelBrowsableApi\\ServiceProvider"
            ]
        }
    }
}
